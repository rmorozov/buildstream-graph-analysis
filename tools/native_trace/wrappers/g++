#!/bin/sh
# UX-880: a grandchild across bwrap cannot open the raw fd
# --jobserver-auth names - this strips it before the real GCC driver's
# own lto-wrapper ever reads MAKEFLAGS (GCC-13 ICE, opts-common.cc:2123)
# and pins an already-requested -flto to a static cap.
set -eu
_bga_self=$(readlink -f -- "$0" 2>/dev/null || printf '%s\n' "$0")
. "$(CDPATH= cd -- "$(dirname -- "$_bga_self")" && pwd)/_common.sh"
bga_run_wrapped flto "$@"
