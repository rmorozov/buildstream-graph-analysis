#!/bin/sh
# UX-846/UX-1337: ctest >= 3.29 is a jobserver client that leaves an fd-pair
# pool non-blocking for make 4.2.1 - this hands it a reopened copy instead.
set -eu
# UX-918: `${var%/*}`, not `dirname` - a staged sandbox has no coreutils.
_bga_self=$(readlink -f -- "$0" 2>/dev/null || printf '%s\n' "$0")
_bga_dir=${_bga_self%/*}
if [ "$_bga_dir" = "$_bga_self" ]; then _bga_dir=.; fi
. "$(CDPATH= cd -- "$_bga_dir" && pwd)/_common.sh"
bga_run_wrapped isolate "$@"
