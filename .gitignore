# examples/: real BuildStream projects whose sandbox-shell binaries and
# throwaway git remote are generated at build time (examples/stage_*.sh),
# not committed - see examples/README.md.
examples/**/files/runtime/bin/*
examples/*/.generated-remote/
examples/03-project-refs-identity/elements/libbar.bst
!examples/**/files/runtime/bin/.gitkeep

# examples/05-cmake-cpp-toolchain/files/toolchain/: a full real gcc/g++/
# cmake/make/binutils sysroot staged from the HOST's own installed
# packages (examples/stage_cpp_toolchain.sh) - ~270MB, host-specific
# (absolute paths/binary content tied to the exact host distro/package
# versions), regenerated at build time, never committed - same reasoning
# as the busybox runtime staging above, scaled up. See examples/README.md.
examples/05-cmake-cpp-toolchain/files/toolchain/

# examples/06-macro-micro-optimization stages the identical sysroot (a
# hardlink clone of 05's - see examples/stage_cpp_toolchain.sh) into its
# own project and into its optimized/ variant. Same reasoning: host-
# specific, ~270MB, regenerated at build time, never committed.
examples/06-macro-micro-optimization/files/toolchain/
examples/06-macro-micro-optimization/optimized/files/toolchain/

# examples/07-declared-vs-used-dependencies stages the identical sysroot
# (another hardlink clone). Same reasoning as 05 and 06.
examples/07-declared-vs-used-dependencies/files/toolchain/

# tests/fixtures/bst_build_root_override/files/runtime/: a real
# dynamically-linked shell and `sleep` plus their library closure,
# staged from the host by that fixture's own stage_runtime.sh. Same rule
# as examples/: host-specific binaries are generated, never committed.
tests/fixtures/bst_build_root_override/files/runtime/
